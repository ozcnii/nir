# Пример окружения сборщика. Скопировать в .env и заполнить.

# --- Задачи, которые решает агент -------------------------------------------
# Имя модели pi, которая умеет смотреть изображения.
CAPTCHA_MODEL=openai-codex/gpt-6-luna
# Сколько ждать ответа модели на одну задачу, секунды.
CAPTCHA_TIMEOUT=360
# Сколько раз за попытку страницы проходить проверку (у Авито ступени идут подряд).
COLLECTION_CAPTCHA_ROUNDS=4

# --- Профиль браузера --------------------------------------------------------
# Пусто — одноразовый контекст. Имя каталога включает постоянную сессию.
COLLECTION_PROFILE=default
COLLECTION_PROFILE_ROOT=~/.cache/nir-collection
COLLECTION_BROWSER_CHANNEL=chrome
COLLECTION_BROWSER_HEADLESS=0

# --- Темп и объём выборки ----------------------------------------------------
# Пусто — без ограничения. Живой прогон задаёт человеческие значения.
COLLECTION_MAX_PAGES=
COLLECTION_MAX_CARDS=
COLLECTION_PAGE_PAUSE=
COLLECTION_CARD_PAUSE=
